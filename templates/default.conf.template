server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    include /etc/nginx/mime.types;
    types {
        application/zip prim;
    }
    # SharedArrayBuffer for EmulatorJS threads (N64 / Doom). Fonts and
    # jsDelivr already send Cross-Origin-Resource-Policy: cross-origin.
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
    location /demo/docket {
        try_files $uri $uri/ /demo/docket/index.html;
    }
    # Prim Browser embed needs cross-origin iframes — no COEP here.
    location /examples/docket {
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        try_files $uri $uri/ /examples/docket/index.html;
    }
}
