server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    include /etc/nginx/mime.types;
    types {
        application/zip prim;
    }
    # SharedArrayBuffer for EmulatorJS threads (N64 / Doom). Fonts and
    # jsDelivr already send Cross-Origin-Resource-Policy: cross-origin.
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Embedder-Policy "require-corp" always;
    location /demo/docket {
        try_files $uri $uri/ /demo/docket/index.html;
    }
    location /docs {
        try_files $uri $uri/ /docs/index.html;
    }
    location /viewers {
        try_files $uri $uri/ /viewers/index.html;
    }
    # Prim Browser embed needs cross-origin iframes — no COEP here.
    # /examples/docket = framed preview only. /examples/prim-browser = companion cockpit.
    location /examples/docket {
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        try_files $uri $uri/ /examples/docket/index.html;
    }
    location /examples/prim-browser {
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        try_files $uri $uri/ /examples/prim-browser/index.html;
    }
    location = /examples/prim { return 302 /examples/prim-browser/; }
    location = /examples/prim/ { return 302 /examples/prim-browser/; }
}
